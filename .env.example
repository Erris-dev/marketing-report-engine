OPENROUTER_API_KEY=
GCP_PROJECT=
# Uses gcloud application-default credentials, or set:
# GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json

# Gmail delivery: use a Google *app password*, never your normal password.
# (Google Account -> Security -> 2-Step Verification -> App passwords)
# Your Gmail address, e.g. name@gmail.com
SMTP_USER=
SMTP_PASSWORD=
# Comma-separated list of addresses that receive the report
REPORT_RECIPIENTS=
